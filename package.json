  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web && node scripts/inject-pwa.mjs",
    "typecheck": "tsc --noEmit",
    "enrich:anatomy": "node scripts/enrich-anatomy-data.js",
    "generate:anatomy": "node scripts/generate-317-pain-map.js data/anatomyPainMap.json",
