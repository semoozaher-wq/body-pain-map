    "validate:triage": "node scripts/validate-triage-tree.js",
    "test": "node --test",
    "test:e2e": "node scripts/e2e-smoke.cjs",
    "build:ios:bundle": "expo export --platform ios --output-dir build/ios",
    "build:android:bundle": "expo export --platform android --output-dir build/android"
