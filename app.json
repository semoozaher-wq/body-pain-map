{
  "expo": {
    "name": "BodyMap Pain",
    "slug": "bodymap-pain",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "bodymap-pain",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.bodymappain.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "com.bodymappain.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "يسمح BodyMap Pain باستخدام الميكروفون للتحدّث مع المساعد الذكي.",
          "speechRecognitionPermission": "يسمح BodyMap Pain بالتعرّف على الكلام لتحويله إلى نص."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يسمح BodyMap Pain بالوصول إلى صورك لإرفاقها بالمساعد الذكي."
        }
      ]
    ]
  }
}
